# Copiá este archivo a .env para correr en tu compu. En Easypanel se cargan como variables de entorno.

# Hora en la que están guardadas las fechas del Sheet (y a la que corre la sincronización semanal)
TZ=Europe/Berlin

# --- Sincronización semanal con Google Sheets (opcional; sin esto la web igual funciona) ---
WEEKLY_SYNC=1
SPREADSHEET_ID=
WORKSHEET_NAME=PlayStore
PRIVATE_APP_ID=ar.com.personalpay
# JSON completo de la cuenta de servicio de Google, en una sola línea
GOOGLE_SERVICE_ACCOUNT_JSON=
